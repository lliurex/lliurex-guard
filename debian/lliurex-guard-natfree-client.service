[Unit]
Description=Service for shutdown lliurex-guard when sutting down or restart the system
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target n4d.service dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/sbin/lliurex-guard-natfree-client-shutdown
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
