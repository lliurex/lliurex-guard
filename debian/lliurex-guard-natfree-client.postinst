#!/bin/sh

set -e
case "$1" in
   configure)

	   systemctl daemon-reload || true
	   systemctl enable lliurex-guard-natfree-client.service || true
	   systemctl start lliurex-guard-natfree-client.service || true

   ;;

   abort-upgrade|abort-remove|abort-deconfigure)
   ;;

   *)
       exit 1
   ;;
esac

#DEBHELPER#

exit 0
